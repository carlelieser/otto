{
  "name": "otto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:boundaries": "vitest run tests/boundaries",
    "build:sidecar": "tsc -p tsconfig.sidecar.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  }
}
