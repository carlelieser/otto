node_modules/
.DS_Store

# The built sidecar, emitted from `src/interfaces/sidecar/` by
# `npm run build:sidecar`.
dist/

# Rust build output.
src-tauri/target/

# Regenerated by `tauri-build` on every build from `capabilities/`, which is
# the file that is actually authored.
src-tauri/gen/

# Agent working directories
.claude/worktrees/

# Backbone working material. Systems are tracked; scratch holds per-run
# artefacts such as code review output, which feeds a pull request body and is
# not itself a durable record.
.backbone/scratch/
