{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto",
  "version": "0.0.0",
  "identifier": "dev.otto.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    },
    "trayIcon": {
      "id": "otto",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
